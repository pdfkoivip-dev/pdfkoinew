{
    "manifest_version": 3,
    "name": "PDFkoi - Free PDF Tools",
    "version": "2.0.0",
    "description": "Quick access to 72+ free online PDF tools. Merge, split, compress, convert PDFs - all in your browser. 100% private, no uploads.",
    "author": "PDFkoi Team",
    "homepage_url": "https://pdfkoi.com",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "PDFkoi - PDF Tools"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "contextMenus",
        "storage"
    ],
    "host_permissions": [
        "https://pdfkoi.com/*"
    ]
}
